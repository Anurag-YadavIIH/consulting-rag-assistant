# Copy to .env.local for local dev. NEXT_PUBLIC_ values are baked into the
# static build at `next build` time, so rebuild after changing them.

# Base URL of the FastAPI backend. Browser-exposed (NEXT_PUBLIC_ prefix)
# because lib/api.ts calls it directly from the client.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Google OAuth web client ID for "Sign in with Google". Public, not a secret.
# Must equal OAUTH_AUDIENCE on the API, and the page's origin (for example
# http://localhost:3000) must be an authorized JavaScript origin for it in
# Google Cloud Console.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Comma-separated engagement list offered to ADMINS who have no explicit
# engagement memberships (there's no API endpoint listing all engagements
# yet). Ignored for everyone else: non-admins only ever see the engagements
# /me returns, and an account with none sees a "no access yet" message.
NEXT_PUBLIC_FALLBACK_ENGAGEMENTS=
