# Copy to terraform.tfvars (gitignored) only if you need to change a default.
# Everything has a working default; the load balancer accepts only CloudFront.

# Temporary direct access to the load balancer for debugging. Off by default.
# Find your public IP with: curl.exe -s https://checkip.amazonaws.com
# Remove this line (and re-apply) as soon as you're done.
# debug_allowed_cidrs = ["YOUR.PUBLIC.IP.HERE/32"]
# Only opens the security group: a direct request then gets the listener's 403.
# To actually reach the API directly, also set:
# debug_bypass_origin_check = true

# The first admin: this email becomes admin at its first verified Google
# sign-in. Personal data, so keep it only in terraform.tfvars (gitignored).
# initial_admin_emails = ["you@example.com"]

# Optional: only these domains may sign in (plus invited emails and the above).
# allowed_email_domains = ["example.com"]

# Enforce the Content-Security-Policy instead of report-only. Only after the
# post-deploy checks show no CSP reports in the browser console.
# csp_enforce = true
